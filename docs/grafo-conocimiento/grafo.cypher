MERGE (n:Nodo:`Patron` {id: 'AD-01'}) SET n += {nombre: 'Crear expediente validado por tipo', descripcion: 'Upsert desde el outbox; $jsonSchema con una rama por cada uno de los 7 tipos', base: 'MG', tipo_acceso: 'E', datos: '_id = id_documento, tipo, contenido, referencias citadas', frecuencia: 'Alta'};
MERGE (n:Nodo:`Patron` {id: 'AD-02'}) SET n += {nombre: 'Leer expediente por _id', descripcion: 'Búsqueda por _id', base: 'MG', tipo_acceso: 'L', datos: 'id_documento', frecuencia: 'Alta'};
MERGE (n:Nodo:`Patron` {id: 'AD-03'}) SET n += {nombre: 'Actualizar contenido según el tipo', descripcion: '$set sobre campos del contenido; el tipo nunca se modifica (D-26)', base: 'MG', tipo_acceso: 'E', datos: 'id, campos', frecuencia: 'Media'};
MERGE (n:Nodo:`Patron` {id: 'AD-04'}) SET n += {nombre: 'Agregar anexo', descripcion: '$push al arreglo anexos con id propio', base: 'MG', tipo_acceso: 'E', datos: 'id, descripción, hojas, ubicación física', frecuencia: 'Media'};
MERGE (n:Nodo:`Patron` {id: 'AD-05'}) SET n += {nombre: 'Agregar nota o evidencia', descripcion: '$push al arreglo notas; la evidencia de conclusión llega por el outbox (D-19)', base: 'MG', tipo_acceso: 'E', datos: 'id, tipo de nota, texto, autor, id_movimiento', frecuencia: 'Media'};
MERGE (n:Nodo:`Patron` {id: 'AD-06'}) SET n += {nombre: 'Quitar anexo o nota', descripcion: '$pull por id del elemento, excepto evidencia_atencion', base: 'MG', tipo_acceso: 'E', datos: 'id, id del elemento', frecuencia: 'Baja'};
MERGE (n:Nodo:`Patron` {id: 'AD-07'}) SET n += {nombre: 'Buscar por campo propio del tipo', descripcion: 'Índices parciales por tipo (partialFilterExpression); devuelve ids que se filtran por visibilidad en PostgreSQL (D-46)', base: 'MG', tipo_acceso: 'L', datos: 'tipo, campo, valor', frecuencia: 'Baja'};
MERGE (n:Nodo:`Patron` {id: 'AD-08'}) SET n += {nombre: 'Verificar expedientes por lote', descripcion: '$in sobre _id proyectando solo el tipo', base: 'MG', tipo_acceso: 'L', datos: 'lista de ids', frecuencia: 'Baja'};
MERGE (n:Nodo:`Patron` {id: 'AG-01'}) SET n += {nombre: 'Recorrido de un documento con ramas', descripcion: 'Desde el nodo Documento por SIGUIENTE entre movimientos (D-09)', base: 'NJ', tipo_acceso: 'L', datos: 'id_documento', frecuencia: 'Alta'};
MERGE (n:Nodo:`Patron` {id: 'AG-02'}) SET n += {nombre: 'Hilo de un asunto', descripcion: 'Las cuatro referencias en ambos sentidos, hasta 6 saltos (D-50)', base: 'NJ', tipo_acceso: 'L', datos: 'id del documento o del asunto', frecuencia: 'Media'};
MERGE (n:Nodo:`Patron` {id: 'AG-03'}) SET n += {nombre: 'Rebotes', descripcion: 'Parte de movimientos filtrados por fecha con índice; cuenta devoluciones y áreas distintas por documento (D-32, D-50)', base: 'NJ', tipo_acceso: 'L', datos: 'periodo, área', frecuencia: 'Media'};
MERGE (n:Nodo:`Patron` {id: 'AG-04'}) SET n += {nombre: 'Alcance de un asunto', descripcion: 'Desde el Asunto a sus documentos y de ahí a áreas y personas de sus movimientos (D-50)', base: 'NJ', tipo_acceso: 'L', datos: 'id del asunto, áreas visibles', frecuencia: 'Baja'};
MERGE (n:Nodo:`Patron` {id: 'AG-05'}) SET n += {nombre: 'Relaciones y asuntos de un documento', descripcion: 'Referencias entrantes y salientes a un salto y asuntos a los que pertenece', base: 'NJ', tipo_acceso: 'L', datos: 'id_documento', frecuencia: 'Alta'};
MERGE (n:Nodo:`Patron` {id: 'AG-06'}) SET n += {nombre: 'Replicar desde el outbox', descripcion: 'MERGE por id; nunca borra Asunto ni referencias (D-25)', base: 'NJ', tipo_acceso: 'E', datos: 'documento, movimiento, área, persona', frecuencia: 'Alta'};
MERGE (n:Nodo:`Patron` {id: 'AG-07'}) SET n += {nombre: 'Crear referencia', descripcion: 'MERGE de la relación; MERGE del DocumentoNoRegistrado por número y emisor (D-33)', base: 'NJ', tipo_acceso: 'E', datos: 'origen, destino, tipo', frecuencia: 'Media'};
MERGE (n:Nodo:`Patron` {id: 'AG-08'}) SET n += {nombre: 'Crear asunto y asignar documento', descripcion: 'CREATE del Asunto con restricción de unicidad; MERGE de PERTENECE_A', base: 'NJ', tipo_acceso: 'E', datos: 'id_asunto, id_documento', frecuencia: 'Media'};
MERGE (n:Nodo:`Patron` {id: 'AG-09'}) SET n += {nombre: 'Quitar referencia o pertenencia', descripcion: 'DELETE de la relación, nunca de nodos', base: 'NJ', tipo_acceso: 'E', datos: 'ids', frecuencia: 'Baja'};
MERGE (n:Nodo:`Patron` {id: 'AG-10'}) SET n += {nombre: 'Detectar faltantes para reconciliar', descripcion: 'UNWIND de ids y OPTIONAL MATCH para reportar nodos o estados faltantes', base: 'NJ', tipo_acceso: 'L', datos: 'lote de ids', frecuencia: 'Baja'};
MERGE (n:Nodo:`Decision` {id: 'D-42'}) SET n += {nombre: 'Regla de pendiente calculada en PostgreSQL', descripcion: 'Un documento está pendiente en un área cuando esa área recibió un movimiento como responsable o apoyo y no hay después un movimiento de salida desde ella ni la conclusión o cancelación del documento. Se calcula de la bitácora en PostgreSQL, sin tabla de estado, para que la bandeja refleje un turno al instante sin esperar la réplica.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-43'}) SET n += {nombre: 'Síntesis del documento en PostgreSQL', descripcion: 'Columna sintesis (texto corto) en el registro oficial para listados y búsqueda; MongoDB guarda el contenido completo. Se llama sintesis y no asunto para no confundirla con el nodo Asunto.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-44'}) SET n += {nombre: 'Cinco roles y permisos de turno', descripcion: 'Oficialía, dirección, titular de área, personal del área y administrador. Oficialía y dirección turnan cualquier documento; el titular hace turnos directos de lo que tiene pendiente, devuelve, returna y atrae; el personal atiende y concluye solo si su área es responsable.', estado: 'tomada', supuesto: true};
MERGE (n:Nodo:`Decision` {id: 'D-45'}) SET n += {nombre: 'Catálogo de operaciones con ids que no se reutilizan', descripcion: 'Se conservan los ids existentes; los números que faltan (O-02, O-04, O-06, O-10, O-12, O-13, O-15, O-16) se consideran eliminados y las operaciones nuevas empiezan en O-19.', estado: 'tomada', supuesto: true, ids_eliminados: '[\'O-02\', \'O-04\', \'O-06\', \'O-10\', \'O-12\', \'O-13\', \'O-15\', \'O-16\']'};
MERGE (n:Nodo:`Decision` {id: 'D-46'}) SET n += {nombre: 'Búsqueda por campos propios del tipo en MongoDB', descripcion: 'Índices parciales por tipo para buscar por datos que solo tiene un tipo (solicitante de transparencia, ente auditor). MongoDB devuelve ids y la visibilidad se filtra en PostgreSQL. Es la operación que distingue a la base documental de una columna JSONB.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-47'}) SET n += {nombre: 'Jerarquía de áreas validada en PostgreSQL', descripcion: 'Los ciclos se detectan con una consulta recursiva dentro de la misma transacción, con la tabla de áreas bloqueada, y no contra la réplica, que puede ir atrasada.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-48'}) SET n += {nombre: 'Outbox con un solo proceso y en orden', descripcion: 'Un único proceso toma los registros en orden de id, porque un movimiento debe llegar después del anterior para unirlos con SIGUIENTE. SKIP LOCKED queda como protección si alguien levanta dos procesos.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-49'}) SET n += {nombre: 'Sesiones guardadas en PostgreSQL', descripcion: 'Código aleatorio en cookie httpOnly y solo su huella SHA-256 en la base; caducan por inactividad. Cerrar sesión revoca de inmediato, cosa que un JWT sin estado no permite.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-50'}) SET n += {nombre: 'Consultas de grafo ancladas y con profundidad máxima', descripcion: 'Toda consulta parte de un Documento, un Asunto o de movimientos filtrados por fecha con índice, nunca de un Área; las áreas de alto grado (oficialía, secretarías particulares) solo aparecen como destino. Los recorridos variables se limitan a 6 saltos.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-51'}) SET n += {nombre: 'C4 se resuelve en PostgreSQL', descripcion: 'Pendientes por responsable no recorre caminos: todo lo que necesita (movimientos, titular al turnar, adscripción) está en PostgreSQL. Presentarla como consulta de grafo debilitaba la justificación de Neo4j. El flujo integrado de la guía lo cubre O-11.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-52'}) SET n += {nombre: 'Relaciones organizacionales solo en PostgreSQL', descripcion: 'Aplica D-22: DEPENDE_DE, TITULAR_DE y ADSCRITA_A no las recorre ninguna consulta de grafo, así que salen de Neo4j; Área y Persona quedan como nodos de id y nombre para los movimientos.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-53'}) SET n += {nombre: 'Ficha completa con degradación controlada', descripcion: 'Si MongoDB o Neo4j no responden, la ficha devuelve lo disponible y marca la sección faltante, como pide la guía en el flujo integrado.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-54'}) SET n += {nombre: 'Estructura del repositorio según la guía', descripcion: 'El repositorio sigue la organización que sugiere la guía (sección 10), con nombres en español donde no choca con ella: api/v1 equivale a controladores, servicios a services y repositorios/relacional|documental|grafo a repositories. El backend va por capas api → servicios → repositorios → infra y solo los repositorios usan drivers.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-55'}) SET n += {nombre: 'Esquemas versionados y versiones fijas', descripcion: 'El esquema de cada base vive en scripts numerados (database/*/schema y validators en MongoDB) que aplica en orden python -m herramientas.esquemas y registra en la tabla esquema_version; también carga data/ y se reproduce desde cero (guía 7.4). Un script aplicado no se edita: se agrega otro. Versiones fijas: Python 3.13 con uv, Node.js 24 LTS, PostgreSQL 17, MongoDB 8.0 y Neo4j 5.26 Community (LTS), con etiqueta de parche fija en las imágenes.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-56'}) SET n += {nombre: 'Pruebas por tipo de la guía con evidencia de ejecución', descripcion: 'Pruebas en tests/unit, tests/integration y tests/e2e, más las consultas y pruebas propias de cada base en database/*/queries y database/graph/tests. Se cubren los tipos de prueba de la guía (sección 9) y, además, una prueba de visibilidad por cada consulta que lee documentos, porque ningún motor la impone. Los resultados se guardan en docs/pruebas/: un script sin evidencia de ejecución no cuenta (guía 12).', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-57'}) SET n += {nombre: 'Desarrollo entre revisor y Claude Code', descripcion: 'El revisor (Claude en claude.ai, con Diego) define arquitectura y alcance, asigna tareas en ai/handoff/siguiente.md y revisa; Claude Code implementa solo lo asignado y reporta en reporte.md e historial/, con un commit por tarea y sin push. Diego lleva los archivos y tiene la última palabra. Precedencia de fuentes: grafo, catálogo de operaciones, arquitectura, modelos y asignación.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-58'}) SET n += {nombre: 'Oficialía registra el acuse; el área responsable concluye', descripcion: 'O-21 marca la salida como acusada e informa al titular del área responsable que el documento al que responde puede concluirse; la conclusión sigue siendo de O-05 (titular y personal del área responsable), como fija D-44. La bandeja del titular muestra la tarjeta «Acuses». Corrige la regla anterior de O-21, que decía que oficialía «ofrece concluirlo».', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-59'}) SET n += {nombre: 'Catálogo cerrado de formas de conclusión', descripcion: 'Cinco formas: con_respuesta (exige un documento de salida o respuesta registrado y enlazado), atencion_sin_oficio (nota evidencia_atencion, D-19), enterado (documento informativo, sin más requisitos), no_procede (nota con el motivo) y duplicado (referencia al documento original, D-27). Toda forma salvo con_respuesta y enterado lleva nota obligatoria; ninguna se borra (D-20). Enumeración versionada en PostgreSQL (D-55). Propuesta por confirmar contra E-2.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-60'}) SET n += {nombre: 'Núcleo en PostgreSQL y campos por tipo en MongoDB', descripcion: 'PostgreSQL guarda solo el núcleo oficial: folio, tipo, asunto, remitente, fecha y fecha límite. Los campos propios de cada tipo de documento van en el expediente de MongoDB con un esquema JSON versionado por tipo (D-55), máximo tres campos específicos por tipo, opcionales salvo la fecha límite en los tipos que exigen respuesta. El detalle por tipo queda por definir en E-2.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-61'}) SET n += {nombre: 'Siglas de área inmutables con folios emitidos', descripcion: 'Las siglas forman parte del folio (D-21), así que no se pueden modificar mientras el área tenga folios emitidos. Administración puede editarlas solo si el área no tiene documentos; los folios ya emitidos conservan las suyas.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-62'}) SET n += {nombre: 'Vistas por rol: bandeja diferenciada y asuntos para Dirección', descripcion: 'Bandeja con dos variantes propias, titular y personal del área, ambas con la tarjeta de acuses (D-58) porque el personal también concluye si su área es responsable (D-44); la diferencia está en la ficha, donde el personal no ve Devolver, Turnar ni Atraer. La búsqueda se reutiliza para todos los roles, porque la visibilidad la filtra el servicio (D-29). Dirección añade «Asuntos» a su menú, solo de consulta: sin asignar documentos ni crear asuntos.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-63'}) SET n += {nombre: 'Interfaz primero con datos simulados', descripcion: 'Con el maquetado aprobado, la interfaz se construye antes que el backend (T-01 y T-02) con datos simulados que siguen el contrato de la API; las páginas leen por funciones de src/api envueltas en TanStack Query y en T-15 se cambian al cliente generado del OpenAPI sin tocar las páginas. La sesión y el rol se simulan hasta entonces. La interfaz sigue sin conectarse a ninguna base (D-36).', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-64'}) SET n += {nombre: 'Sistema visual del frontend desde el Figma', descripcion: 'Tokens del Figma (identidad Señal Guinda) en src/estilos/tokens.css; CSS Modules sin Tailwind ni biblioteca de componentes; Radix UI solo para primitivas accesibles (diálogo, menú, selector, pestañas, ventana emergente); fuentes Unbounded, Geist y Geist Mono autoalojadas con Fontsource; íconos SVG del Figma; escritorio primero (1280 a 1920 px); pruebas con Vitest y Testing Library. Cierra la elección que D-38 dejó para después del maquetado.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-65'}) SET n += {nombre: 'Los siete tipos de documento: nombres y alcance', descripcion: 'Oficio, solicitud de material o pago, requerimiento de auditoría, solicitud de transparencia, memorándum, circular e informe (ids oficio, solicitud_material_pago, requerimiento_auditoria, solicitud_transparencia, memorandum, circular, informe). Los cuatro primeros salen de D-17 y del maquetado. Memorándum, circular e informe son un supuesto, porque la entrevista (simulada) no los nombró: se cierran sin ampliar el alcance, sin campos propios (solo el núcleo de D-60) y con una rama de $jsonSchema sin más requisitos. Los campos propios de material o pago, auditoría y transparencia, hasta tres por tipo (D-60), se definen en E-2.', estado: 'tomada', supuesto: true};
MERGE (n:Nodo:`Decision` {id: 'D-66'}) SET n += {nombre: 'Campos propios por tipo de documento', descripcion: 'Solo tres tipos llevan campos propios, guardados en el expediente de MongoDB dentro del esquema versionado (D-55, D-60). Requerimiento de auditoría: ente_auditor (texto, obligatorio, con índice parcial según D-46) y puntos (lista de textos, opcional, sin búsqueda). Solicitud de transparencia: solicitante (texto, obligatorio, con índice parcial según D-46). Solicitud de material o pago: concepto (texto, opcional, sin búsqueda; es un supuesto). Oficio, memorándum, circular e informe no tienen campos propios. No se agregan consultas ni índices más allá de D-46, ni montos, fechas o estados por tipo. La interfaz muestra el bloque «Datos del tipo» al registrar y en la ficha solo cuando el tipo lo tiene.', estado: 'tomada', supuesto: true};
MERGE (n:Nodo:`Hueco` {id: 'HU-PEN'}) SET n += {nombre: 'Regla de pendiente y ubicación vigente con ramas', descripcion: 'Calculada de la bitácora en PostgreSQL.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-SIN'}) SET n += {nombre: 'Descripción corta para listados', descripcion: 'Columna sintesis en PostgreSQL.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-ROL'}) SET n += {nombre: 'Roles y permisos de turno sin definir', descripcion: 'Cinco roles con permisos de turno.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-NUM'}) SET n += {nombre: 'Ids de operaciones faltantes', descripcion: 'No se reutilizan; se consideran eliminados.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-MG2'}) SET n += {nombre: 'Justificación de MongoDB débil frente a JSONB', descripcion: 'Búsqueda por campos propios del tipo con índices parciales.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-JER'}) SET n += {nombre: 'Ciclos validados contra una réplica atrasada', descripcion: 'Validación en PostgreSQL dentro de la transacción.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-ORD'}) SET n += {nombre: 'Orden de replicación de movimientos', descripcion: 'Un solo proceso en orden de id.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-SES'}) SET n += {nombre: 'Revocación de sesiones', descripcion: 'Sesiones en PostgreSQL, revocables al instante.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-CON4'}) SET n += {nombre: 'C4 presentada como consulta de grafo sin recorrido', descripcion: 'Se resuelve en PostgreSQL.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-NJ2'}) SET n += {nombre: 'Relaciones organizacionales que ninguna consulta recorre', descripcion: 'Salen de Neo4j por D-22.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-DEG'}) SET n += {nombre: 'Falla parcial al leer la ficha integrada', descripcion: 'Devuelve lo disponible y marca lo faltante.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-ASU2'}) SET n += {nombre: 'Documento en varios asuntos', descripcion: 'Permitido.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-EVI'}) SET n += {nombre: 'Borrar la evidencia de una conclusión', descripcion: 'La nota evidencia_atencion no se elimina con O-17.', estado: 'resuelto'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-18'}) SET n += {nombre: 'Un solo proceso de outbox', descripcion: 'Limita el ritmo de réplica; suficiente para el volumen de la oficialía.', estado: 'aceptada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-19'}) SET n += {nombre: 'Pendientes calculados en cada consulta', descripcion: 'Sin tabla de estado; depende de un índice sobre la bitácora.', estado: 'aceptada'};

