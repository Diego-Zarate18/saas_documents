// Grafo de conocimiento de SIGEDOC. Ejecutar en una base de Neo4j dedicada.
// Actualizado: 2026-11-22

CREATE CONSTRAINT nodo_id IF NOT EXISTS FOR (n:Nodo) REQUIRE n.id IS UNIQUE;

MERGE (n:Nodo:`Proyecto` {id: 'PRY'}) SET n += {nombre: 'SIGEDOC', descripcion: 'Sistema de Seguimiento de Documentos entre Departamentos. Proyecto final de bases de datos: una aplicación que integra una base relacional, una documental y una de grafos.'};
MERGE (n:Nodo:`Contexto` {id: 'CTX-01'}) SET n += {nombre: 'Organización estudiada', descripcion: 'Oficialía de Partes y Control de Gestión de una Dirección General de Administración. 120 a 150 documentos por semana, el doble en temporadas altas (1c).'};
MERGE (n:Nodo:`Contexto` {id: 'CTX-02'}) SET n += {nombre: 'Guía del proyecto final', descripcion: 'Universidad Politécnica de Chiapas: una sola aplicación con tres paradigmas justificados, integración por API, fuente de verdad definida y 8 entregables.'};
MERGE (n:Nodo:`Contexto` {id: 'CTX-03'}) SET n += {nombre: 'Alcance de evaluación', descripcion: 'La aplicación se evalúa hasta que los datos se sirven, consultan, modifican y eliminan, junto con los servicios que eso requiere.'};
MERGE (n:Nodo:`Contexto` {id: 'CTX-04'}) SET n += {nombre: 'Entrevista de requerimientos', descripcion: 'Entrevista a la encargada de la Oficialía de Partes (43 preguntas). Las referencias como 4d remiten a sus respuestas.'};
MERGE (n:Nodo:`Problema` {id: 'P-01'}) SET n += {nombre: 'No se sabe dónde está un documento ni quién debe atenderlo', descripcion: 'Problema principal según la entrevistada (11a). De él se derivan atrasos, pérdidas y el \'a mí no me llegó\'.'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-01'}) SET n += {nombre: 'Registro disperso', descripcion: 'Excel compartido, libretas de entrega y controles propios por área. El sistema anterior se perdió en un cambio de administración (3b).', referencia_entrevista: '3b'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-02'}) SET n += {nombre: 'Turnos ambiguos', descripcion: 'El director turna a varias áreas con \'atender\' y ninguna se asume responsable (4b).', referencia_entrevista: '4b'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-03'}) SET n += {nombre: 'Rebotes sin rastro', descripcion: 'Caso del arrendamiento: casi tres meses entre Materiales, Financieros y Jurídico; nadie pudo reconstruir el recorrido (4d).', referencia_entrevista: '4d'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-04'}) SET n += {nombre: 'Varios identificadores por documento', descripcion: 'Número del emisor, folio de recepción y a veces un tercer folio interno (2b, 2c).', referencia_entrevista: '2b, 2c'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-05'}) SET n += {nombre: 'Movimientos fuera del registro', descripcion: 'Entregas en mano, turnos directos entre áreas, fotos por WhatsApp y copias archivadas sin registro (3c).', referencia_entrevista: '3c'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-06'}) SET n += {nombre: 'Registros editables sin rastro', descripcion: 'En el Excel cualquiera modifica o borra filas sin dejar constancia (10c).', referencia_entrevista: '10c'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-07'}) SET n += {nombre: 'Información heterogénea por tipo', descripcion: 'Cada tipo de documento trae datos distintos: anexos, puntos de auditoría, solicitantes de transparencia (2a, 2e).', referencia_entrevista: '2a, 2e'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-08'}) SET n += {nombre: 'Memoria institucional frágil', descripcion: 'Los asuntos se ligan por la memoria de las personas y se pierden con los cambios de administración (5f, 11c).', referencia_entrevista: '5f, 11c'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-09'}) SET n += {nombre: 'Atención sin oficio', descripcion: 'Asuntos resueltos por teléfono o reunión quedan pendientes para siempre en el control (5d).', referencia_entrevista: '5d'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-10'}) SET n += {nombre: 'Respuestas integradas de varias áreas', descripcion: 'Los requerimientos de auditoría se contestan por partes y alguien integra una sola respuesta (5c).', referencia_entrevista: '5c'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-01'}) SET n += {nombre: 'Registrar documentos', descripcion: 'Registrar documentos.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-02'}) SET n += {nombre: 'Varios identificadores y detección de duplicados', descripcion: 'Número del emisor, folio de recepción y UUID; detección de duplicados por número, emisor y año de fecha_documento.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-03'}) SET n += {nombre: 'Turnos con rol: responsable, apoyo o conocimiento', descripcion: 'Turnos con rol: responsable, apoyo o conocimiento.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-04'}) SET n += {nombre: 'Registrar devoluciones, returnos, turnos directos y atracciones', descripcion: 'Registrar devoluciones, returnos, turnos directos y atracciones.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-05'}) SET n += {nombre: 'Relacionar documentos: respuesta, seguimiento, alcance, sustitución', descripcion: 'Relacionar documentos: respuesta, seguimiento, alcance, sustitución.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-06'}) SET n += {nombre: 'Agrupar documentos en asuntos', descripcion: 'Agrupar documentos en asuntos.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-07'}) SET n += {nombre: 'Ubicación actual y recorrido completo', descripcion: 'Ubicación actual y recorrido completo.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-08'}) SET n += {nombre: 'Reconstruir el hilo de un asunto', descripcion: 'Reconstruir el hilo de un asunto.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-09'}) SET n += {nombre: 'Control de plazos en días hábiles', descripcion: 'Control de plazos en días hábiles.', estado: 'retirado'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-10'}) SET n += {nombre: 'Concluir documentos según su tipo', descripcion: 'Concluir documentos según su tipo.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-11'}) SET n += {nombre: 'Detectar rebotes', descripcion: 'Detectar rebotes distinguiéndolos de devoluciones con motivo concreto.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-12'}) SET n += {nombre: 'Pendientes por área con antigüedad (acotado)', descripcion: 'Pendientes por área con antigüedad (acotado).', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-13'}) SET n += {nombre: 'Estructura organizacional actual', descripcion: 'Estructura organizacional actual.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-14'}) SET n += {nombre: 'Registrar salidas externas con acuse', descripcion: 'Registrar salidas externas con acuse.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-15'}) SET n += {nombre: 'Bitácora que no se edita ni se borra', descripcion: 'Bitácora que no se edita ni se borra.', estado: 'activo'};
MERGE (n:Nodo:`Requerimiento` {id: 'RF-16'}) SET n += {nombre: 'Control de acceso por rol, área y persona', descripcion: 'Cada área ve lo suyo completo y de lo demás solo estado y responsable; los confidenciales solo el titular y quien tiene movimiento sobre ellos.', estado: 'activo'};
MERGE (n:Nodo:`Consulta` {id: 'C1'}) SET n += {nombre: 'Recorrido de un documento', descripcion: 'Ubicación vigente desde PostgreSQL (D-42) y recorrido con ramas desde Neo4j.', bases: 'PG+NJ'};
MERGE (n:Nodo:`Consulta` {id: 'C2'}) SET n += {nombre: 'Hilo de un asunto', descripcion: 'Documentos relacionados hasta 6 saltos (D-50) y su estado de conclusión.', bases: 'NJ+PG'};
MERGE (n:Nodo:`Consulta` {id: 'C3'}) SET n += {nombre: 'Rebotes entre áreas', descripcion: 'Devoluciones sin motivo, \'no competencia\' sin área sugerida, tres o más devoluciones o tres o más áreas distintas (D-32).', bases: 'NJ'};
MERGE (n:Nodo:`Consulta` {id: 'C4'}) SET n += {nombre: 'Pendientes por responsable', descripcion: 'Se resuelve en PostgreSQL (D-51); la expone O-14.', bases: 'PG'};
MERGE (n:Nodo:`Consulta` {id: 'C5'}) SET n += {nombre: 'Alcance de un asunto', descripcion: 'Áreas y personas con contacto con algún documento del asunto, filtradas por visibilidad.', bases: 'NJ'};
MERGE (n:Nodo:`Base` {id: 'DB-PG'}) SET n += {nombre: 'PostgreSQL', descripcion: 'Relacional. Registro oficial del documento, folios, áreas, personas, actores externos, bitácora de movimientos y outbox. Se elige por garantías (folios sin huecos con escritura concurrente, bitácora inmutable, llaves foráneas, outbox en la misma transacción), no por escala.', paradigma: 'relacional'};
MERGE (n:Nodo:`Base` {id: 'DB-MG'}) SET n += {nombre: 'MongoDB', descripcion: 'Documental. Colección expedientes: contenido variable por tipo, anexos y notas anidados, validación $jsonSchema.', paradigma: 'documental'};
MERGE (n:Nodo:`Base` {id: 'DB-NJ'}) SET n += {nombre: 'Neo4j', descripcion: 'Grafos. Recorrido, referencias entre documentos, asuntos y documentos no registrados. 6 etiquetas; las relaciones organizacionales viven solo en PostgreSQL (D-52).', paradigma: 'grafos'};
MERGE (n:Nodo:`Concepto` {id: 'K-DOC'}) SET n += {nombre: 'Documento', descripcion: 'Registro oficial: número, tipo (7), origen, estado, confidencial, síntesis, canal y fechas de recepción inicial y oficial. Neo4j guarda id, tipo, estado y confidencial; MongoDB guarda id y tipo.'};
MERGE (n:Nodo:`Concepto` {id: 'K-EXP'}) SET n += {nombre: 'Expediente', descripcion: 'Contenido del documento según su tipo, con anexos y notas. _id igual a id_documento.'};
MERGE (n:Nodo:`Concepto` {id: 'K-FOL'}) SET n += {nombre: 'Folio de recepción', descripcion: 'Folio por área receptora, consecutivo por área y año, sin huecos.'};
MERGE (n:Nodo:`Concepto` {id: 'K-MOV'}) SET n += {nombre: 'Movimiento', descripcion: 'Cada paso del recorrido, con motivo de devolución e id del titular del área destino al turnar. Bitácora inmutable en PostgreSQL, réplica completa en Neo4j.'};
MERGE (n:Nodo:`Concepto` {id: 'K-ASU'}) SET n += {nombre: 'Asunto', descripcion: 'Tema de fondo que agrupa documentos. Solo existe en Neo4j.'};
MERGE (n:Nodo:`Concepto` {id: 'K-ARE'}) SET n += {nombre: 'Área', descripcion: 'Unidad organizacional con titular, dependencia y estado (activa o inactiva), sin sucesión. La jerarquía vive solo en PostgreSQL; Neo4j guarda id y siglas.'};
MERGE (n:Nodo:`Concepto` {id: 'K-PER'}) SET n += {nombre: 'Persona', descripcion: 'Servidor público y usuario. Neo4j solo guarda id y nombre.'};
MERGE (n:Nodo:`Concepto` {id: 'K-ACT'}) SET n += {nombre: 'Actor externo', descripcion: 'Institución, municipio, proveedor o ciudadano externo. Solo en PostgreSQL.'};
MERGE (n:Nodo:`Concepto` {id: 'K-REF'}) SET n += {nombre: 'Referencias entre documentos', descripcion: 'RESPONDE_A, DA_SEGUIMIENTO_A, EN_ALCANCE_A, SUSTITUYE_A; pueden apuntar a un documento no registrado. Fuente de verdad en Neo4j.'};
MERGE (n:Nodo:`Operacion` {id: 'O-01'}) SET n += {nombre: 'Registrar documento recibido y asignar folio', descripcion: 'Una sola transacción: folio con contador bloqueado por área y año de registro (D-21, D-34); si número, emisor y año de la fecha del documento ya existen, no crea nada y ofrece O-19 (D-27); sin número o sin fecha se marca posible_duplicado; todo documento tiene emisor (RI-06); encola el expediente y el nodo en el outbox (D-13)', seccion: 'Recepción, registro y corrección', roles: 'OF', recibe: 'Tipo, número del emisor (opcional), emisor (área o actor externo), fecha del documento, canal (correo o papel), fecha y hora de recepción, síntesis, confidencial, contenido según el tipo, marca de extemporáneo', devuelve: 'Id, folio y, si aplica, el documento que ya existe con el mismo número', reglas: 'Una sola transacción: folio con contador bloqueado por área y año de registro (D-21, D-34); si número, emisor y año de la fecha del documento ya existen, no crea nada y ofrece O-19 (D-27); sin número o sin fecha se marca posible_duplicado; todo documento tiene emisor (RI-06); encola el expediente y el nodo en el outbox (D-13)', tipo_operacion: 'E', bases: 'PG+MG+NJ', frecuencia: 'Alta', nucleo: true};
MERGE (n:Nodo:`Operacion` {id: 'O-03'}) SET n += {nombre: 'Turnar a una o varias áreas', descripcion: 'Exactamente un responsable por grupo (RI-10); guarda el titular del área destino al turnar, nulo si está vacante (D-31); oficialía y dirección turnan cualquier documento, el titular solo los que tiene pendientes en su área (turno directo) (D-44); no se turnan documentos concluidos ni cancelados', seccion: 'Recorrido del documento', roles: 'OF, DI, TI', recibe: 'Id del documento y, por área destino, su rol (responsable, apoyo o conocimiento) e instrucción', devuelve: 'Movimientos creados con su id_grupo_turno', reglas: 'Exactamente un responsable por grupo (RI-10); guarda el titular del área destino al turnar, nulo si está vacante (D-31); oficialía y dirección turnan cualquier documento, el titular solo los que tiene pendientes en su área (turno directo) (D-44); no se turnan documentos concluidos ni cancelados', tipo_operacion: 'E', bases: 'PG+NJ', frecuencia: 'Alta', nucleo: true};
MERGE (n:Nodo:`Operacion` {id: 'O-05'}) SET n += {nombre: 'Concluir documento', descripcion: 'Solo el área responsable con el documento pendiente (D-44); conclusión explícita (RI-14) con una forma del catálogo de D-59; la atención sin oficio exige la nota evidencia_atencion ligada al movimiento (D-19), escrita en MongoDB por el outbox; cierra los pendientes de todas las ramas', seccion: 'Recorrido del documento', roles: 'TI, PE', recibe: 'Id del documento, forma de conclusión (catálogo de D-59), documento de respuesta (opcional), evidencia (si fue sin oficio)', devuelve: 'Documento concluido', reglas: 'Solo el área responsable con el documento pendiente (D-44); conclusión explícita (RI-14) con una forma del catálogo de D-59; la atención sin oficio exige la nota evidencia_atencion ligada al movimiento (D-19), escrita en MongoDB por el outbox; cierra los pendientes de todas las ramas', tipo_operacion: 'E', bases: 'PG+NJ+MG', frecuencia: 'Alta', nucleo: true};
MERGE (n:Nodo:`Operacion` {id: 'O-07'}) SET n += {nombre: 'Relacionar documentos', descripcion: 'Sin autorreferencia; destino no registrado crea o reutiliza un DocumentoNoRegistrado con el mismo número y emisor (D-33); SUSTITUYE_A solo entre registrados y deja al sustituido sin_efecto en PostgreSQL con reconciliación (D-14); requiere visibilidad sobre el origen', seccion: 'Relaciones y asuntos', roles: 'OF, TI, PE', recibe: 'Documento origen, destino (id, o número y emisor en texto si no está registrado) y tipo de relación', devuelve: 'Relación creada', reglas: 'Sin autorreferencia; destino no registrado crea o reutiliza un DocumentoNoRegistrado con el mismo número y emisor (D-33); SUSTITUYE_A solo entre registrados y deja al sustituido sin_efecto en PostgreSQL con reconciliación (D-14); requiere visibilidad sobre el origen', tipo_operacion: 'E', bases: 'NJ+PG', frecuencia: 'Media', nucleo: true};
MERGE (n:Nodo:`Operacion` {id: 'O-09'}) SET n += {nombre: 'Consultar y actualizar contenido del expediente', descripcion: 'Validación por tipo con $jsonSchema; el tipo no cambia (D-26); lo confidencial solo lo ven el titular y quien tiene movimiento (D-29); los documentos cancelados son de solo lectura', seccion: 'Expediente', roles: 'OF, TI, PE', recibe: 'Id del documento y campos del contenido', devuelve: 'Expediente actualizado', reglas: 'Validación por tipo con $jsonSchema; el tipo no cambia (D-26); lo confidencial solo lo ven el titular y quien tiene movimiento (D-29); los documentos cancelados son de solo lectura', tipo_operacion: 'L+E', bases: 'MG', frecuencia: 'Media', nucleo: true};
MERGE (n:Nodo:`Operacion` {id: 'O-11'}) SET n += {nombre: 'Ficha completa de un documento', descripcion: 'Flujo integrado de las tres bases; si MongoDB o Neo4j no responden, devuelve lo disponible y marca la sección faltante (D-53); contenido confidencial oculto según D-29', seccion: 'Consultas', roles: 'OF, DI, TI, PE', recibe: 'Id del documento', devuelve: 'Registro, folios y acuses; expediente; recorrido con tiempos (C1); relaciones y asuntos', reglas: 'Flujo integrado de las tres bases; si MongoDB o Neo4j no responden, devuelve lo disponible y marca la sección faltante (D-53); contenido confidencial oculto según D-29', tipo_operacion: 'L', bases: 'PG+MG+NJ', frecuencia: 'Alta', nucleo: true};
MERGE (n:Nodo:`Operacion` {id: 'O-14'}) SET n += {nombre: 'Pendientes por área y responsable (bandeja)', descripcion: 'Regla de pendiente de D-42, calculada en PostgreSQL para que refleje un turno al instante; implementa C4 (D-51)', seccion: 'Consultas', roles: 'OF, DI, TI, PE', recibe: 'Área (o todas, según el rol), filtros por tipo y antigüedad', devuelve: 'Documentos pendientes con rol, antigüedad en días naturales, titular al turnar y si quien lo recibió ya no está adscrito', reglas: 'Regla de pendiente de D-42, calculada en PostgreSQL para que refleje un turno al instante; implementa C4 (D-51)', tipo_operacion: 'L', bases: 'PG', frecuencia: 'Alta', nucleo: true};
MERGE (n:Nodo:`Operacion` {id: 'O-17'}) SET n += {nombre: 'Eliminar anexo o nota', descripcion: 'Solo capturas por error, por su autor u oficialía (D-20); la nota evidencia_atencion de una conclusión no se elimina, porque dejaría sin evidencia a RF-10', seccion: 'Expediente', roles: 'OF, PE', recibe: 'Id del documento e id del anexo o la nota', devuelve: 'Confirmación', reglas: 'Solo capturas por error, por su autor u oficialía (D-20); la nota evidencia_atencion de una conclusión no se elimina, porque dejaría sin evidencia a RF-10', tipo_operacion: 'E', bases: 'MG', frecuencia: 'Baja', nucleo: false};
MERGE (n:Nodo:`Operacion` {id: 'O-18'}) SET n += {nombre: 'Quitar referencia o sacar de un asunto', descripcion: 'Solo capturas por error (D-20); quitar SUSTITUYE_A devuelve al documento su estado anterior con la misma reconciliación de D-14', seccion: 'Relaciones y asuntos', roles: 'OF, TI, PE', recibe: 'Id de la relación o de la pertenencia', devuelve: 'Confirmación', reglas: 'Solo capturas por error (D-20); quitar SUSTITUYE_A devuelve al documento su estado anterior con la misma reconciliación de D-14', tipo_operacion: 'E', bases: 'NJ', frecuencia: 'Baja', nucleo: false};
MERGE (n:Nodo:`Decision` {id: 'D-01'}) SET n += {nombre: 'Acotar a una sola organización', descripcion: 'Se descartó el seguimiento entre N dependencias por los huecos de participación, actores y gobernanza.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-02'}) SET n += {nombre: 'El documento es el protagonista', descripcion: 'El modelo sigue al documento; los departamentos son el mapa. Genérico para N departamentos.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-03'}) SET n += {nombre: 'Movimiento como entidad, no relación', descripcion: 'Cada paso une documento, dos áreas y personas, y debe ser inmutable.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-04'}) SET n += {nombre: 'Relaciones tipadas Documento-Área', descripcion: 'EMITIDO_POR, DIRIGIDO_A y COPIA_A separadas para distinguir responsable de enterado.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-05'}) SET n += {nombre: 'Cuatro relaciones entre documentos separadas', descripcion: 'Se conservan RESPONDE_A, DA_SEGUIMIENTO_A, EN_ALCANCE_A y SUSTITUYE_A en vez de REFERENCIA_A {tipo}.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-06'}) SET n += {nombre: 'Retirar RF-09 (plazos)', descripcion: 'Sin calendario de días inhábiles ni vencimientos para acotar el alcance.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-07'}) SET n += {nombre: 'Acotar RF-12 a pendientes por área', descripcion: 'Sin tiempos promedio ni cumplimiento; antigüedad en días naturales.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-08'}) SET n += {nombre: 'Estructura organizacional solo en estado actual', descripcion: 'TITULAR_DE, ADSCRITA_A y DEPENDE_DE sin desde/hasta.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-09'}) SET n += {nombre: 'SIGUIENTE N:M', descripcion: 'El recorrido puede dividirse en ramas y volver a unirse cuando varias áreas integran una respuesta.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-10'}) SET n += {nombre: 'Motores: PostgreSQL, MongoDB y Neo4j, cada uno por una necesidad', descripcion: 'PostgreSQL: folios sin huecos, bitácora inmutable e integridad con escritura concurrente (D-35). MongoDB: contenido que cambia según el tipo de documento (H-07), con anexos y notas anidados y validación por tipo. Neo4j: recorridos y patrones de C1 a C3, referencias entre documentos y asuntos. Si se quita PostgreSQL se pierde la integridad transaccional; si se quita MongoDB el contenido iría en JSONB, sin validación declarativa por tipo y mezclado con el registro transaccional; si se quita Neo4j los recorridos serían consultas recursivas en SQL, menos legibles.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-11'}) SET n += {nombre: 'Movimiento con fuente en PostgreSQL', descripcion: 'Transacción e inmutabilidad en la relacional; réplica completa a Neo4j para recorrer.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-12'}) SET n += {nombre: 'ActorExterno fuera del grafo', descripcion: 'Ninguna consulta de grafo lo necesita.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-13'}) SET n += {nombre: 'Patrón outbox', descripcion: 'La transacción relacional guarda un registro de sincronización pendiente; un proceso reintenta hacia Neo4j o MongoDB.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-14'}) SET n += {nombre: 'Consulta de reconciliación para sustituciones', descripcion: 'SUSTITUYE_A se escribe en Neo4j y luego el estado en PostgreSQL; la reconciliación detecta fallas a medias.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-15'}) SET n += {nombre: 'Un mismo UUID en las tres bases', descripcion: 'Generado por el backend; _id en MongoDB e id en Neo4j.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-16'}) SET n += {nombre: 'Expediente con _id = id_documento', descripcion: 'Relación 1:1 sin tabla de equivalencias; tipo copiado como dato inmutable.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-17'}) SET n += {nombre: 'Catálogo de 7 tipos de documento', descripcion: 'Separa solicitud de material o pago, requerimiento de auditoría y solicitud de transparencia. Los siete nombres están en D-65.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-18'}) SET n += {nombre: 'id_grupo_turno para RI-10', descripcion: 'Agrupa turnos simultáneos en lugar de comparar fecha_hora.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-19'}) SET n += {nombre: 'Evidencia como nota del expediente', descripcion: 'Nota evidencia_atencion ligada al id_movimiento de la conclusión.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-20'}) SET n += {nombre: 'Documentos y movimientos no se borran', descripcion: 'Se cancelan o corrigen; solo se eliminan anexos, notas, referencias y pertenencias a asuntos capturados por error.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-21'}) SET n += {nombre: 'Folios con contador bloqueado', descripcion: 'contador_folio con SELECT ... FOR UPDATE en la transacción para no dejar huecos.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-22'}) SET n += {nombre: 'Grafo adelgazado', descripcion: '5 etiquetas y 16 relaciones; sale todo lo que tiene fuente en PostgreSQL y no se recorre.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-23'}) SET n += {nombre: 'Proyecto en documentos nuevos', descripcion: 'Los entregables de la actividad de grafos se conservan; el proyecto final vive en un documento propio.', estado: 'tomada'};
MERGE (n:Nodo:`Hueco` {id: 'HU-A1'}) SET n += {nombre: 'Unidad de seguimiento: documento o asunto', descripcion: 'Se siguen ambos: Documento y Asunto (RF-06).', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-A2'}) SET n += {nombre: 'Varios identificadores y número no único', descripcion: 'UUID propio más folio por área; UNIQUE parcial sobre número, emisor y año de fecha_documento.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-A4'}) SET n += {nombre: '¿Copias como mismo documento o instancias?', descripcion: 'Mismo documento con relación COPIA_A.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-A5'}) SET n += {nombre: 'Anexos que se separan del oficio', descripcion: 'Anexos anidados en el expediente con su ubicación física.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-A6'}) SET n += {nombre: 'Documentos cancelados o sustituidos', descripcion: 'Estado cancelado/sin_efecto y SUSTITUYE_A.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-B2'}) SET n += {nombre: '¿Todas las dependencias usan el sistema?', descripcion: 'Desaparece al acotar a una organización.', estado: 'eliminado'};
MERGE (n:Nodo:`Hueco` {id: 'HU-B3'}) SET n += {nombre: 'Actores externos y entradas/salidas', descripcion: 'ActorExterno en PostgreSQL; salidas con acuse (RF-14).', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-B4'}) SET n += {nombre: '¿Documentos dirigidos a personas o a áreas?', descripcion: 'Se atiende por área; el titular actual responde.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-C1'}) SET n += {nombre: 'Reestructuraciones y vigencias', descripcion: 'Reestructuraciones fuera de alcance: áreas solo con estado actual, sin sucesión. El titular al momento del turno se guarda en el movimiento.', estado: 'aceptado'};
MERGE (n:Nodo:`Hueco` {id: 'HU-C3'}) SET n += {nombre: 'Varias fechas por documento', descripcion: 'fecha_documento, fecha_recepcion_inicial, fecha_recepcion_oficial, fecha_hora del movimiento y fecha_registro.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-C4'}) SET n += {nombre: 'Plazos en días hábiles', descripcion: 'Fuera de alcance.', estado: 'aceptado'};
MERGE (n:Nodo:`Hueco` {id: 'HU-D1'}) SET n += {nombre: 'Turno múltiple sin responsable claro', descripcion: 'Rol por movimiento y un solo responsable por grupo de turno (RI-10).', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-D3'}) SET n += {nombre: 'Regla de conclusión', descripcion: 'RF-10 y RI-14: conclusión explícita con forma_conclusion.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-D4'}) SET n += {nombre: 'Respuestas N:M y parciales', descripcion: 'RESPONDE_A N:M y SIGUIENTE N:M.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-D5'}) SET n += {nombre: 'Respuestas fuera del sistema', descripcion: 'atencion_sin_oficio con nota de evidencia.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-D6'}) SET n += {nombre: 'Ciclos legítimos frente a rebotes', descripcion: 'Devolución legítima con motivo del catálogo; rebote sin motivo, \'no competencia\' sin área sugerida o tres o más áreas.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-E2'}) SET n += {nombre: 'Referencias capturadas a mano', descripcion: 'No hay extracción automática; referencias_citadas es solo informativo.', estado: 'aceptado'};
MERGE (n:Nodo:`Hueco` {id: 'HU-E3'}) SET n += {nombre: 'Referencias a documentos fuera del sistema', descripcion: 'Nodo DocumentoNoRegistrado con número y emisor en texto.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-E4'}) SET n += {nombre: 'Cómo se forma un asunto', descripcion: 'Asignación manual por quien atiende, en cualquier momento (O-08), y corrección con O-18.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-F1'}) SET n += {nombre: 'Supernodos (oficialía, secretarías particulares)', descripcion: 'Las consultas se anclan en documento, asunto o fecha; las áreas de alto grado solo aparecen como destino.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-F4'}) SET n += {nombre: 'Explosión de caminos en consultas variables', descripcion: 'Recorridos variables limitados a 6 saltos.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-G1'}) SET n += {nombre: 'El sistema refleja registros, no la realidad', descripcion: 'Limitación declarada: movimientos no capturados no existen para el sistema.', estado: 'aceptado'};
MERGE (n:Nodo:`Hueco` {id: 'HU-G2'}) SET n += {nombre: 'Duplicados por correo y papel', descripcion: 'UNIQUE parcial sobre número, emisor y año de fecha_documento, y marca posible_duplicado.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-H1'}) SET n += {nombre: 'Visibilidad entre áreas', descripcion: 'Tres niveles de visibilidad aplicados en el backend (D-29).', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-H3'}) SET n += {nombre: 'Auditoría e inmutabilidad', descripcion: 'Disparador que impide UPDATE y DELETE; correcciones con CORRIGE.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-I1'}) SET n += {nombre: 'Riesgo de que el proyecto sea CRUD', descripcion: 'C1 a C5 como centro y prueba de suficiencia por base.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-RF10'}) SET n += {nombre: 'RF-10 sin cobertura al quitar evidencia', descripcion: 'Evidencia trasladada al expediente.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-EMI'}) SET n += {nombre: 'Documentos externos sin emisor en el grafo', descripcion: 'RI-06 se valida en PostgreSQL; EMITIDO_POR opcional en Neo4j.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-R10'}) SET n += {nombre: 'RI-10 comparaba fecha_hora', descripcion: 'Coincidencias accidentales evitadas con id_grupo_turno.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-INT'}) SET n += {nombre: '¿La interfaz es obligatoria?', descripcion: 'Obligatoria (confirmado). Aplicación web que consume la API (D-36).', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-STK'}) SET n += {nombre: 'Lenguaje y framework del backend', descripcion: 'Python con FastAPI en el backend y React con Vite en la interfaz (D-37, D-38).', estado: 'resuelto'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-01'}) SET n += {nombre: 'Sin historial de titulares y adscripciones', descripcion: 'Sin historial completo; quién era titular al turnar queda guardado en el movimiento.', estado: 'parchada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-02'}) SET n += {nombre: 'Sin plazos ni días hábiles', descripcion: 'No se detectan vencimientos legales (transparencia, auditoría).', estado: 'aceptada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-03'}) SET n += {nombre: 'Anexos sin archivos binarios', descripcion: 'Solo se guardan datos descriptivos de los anexos.', estado: 'aceptada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-04'}) SET n += {nombre: 'Consistencia eventual en las réplicas de Neo4j', descripcion: 'Ventana entre la escritura en PostgreSQL y la réplica; mitigada con outbox y reintentos.', estado: 'parchada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-05'}) SET n += {nombre: 'Reglas que Neo4j Community no impone', descripcion: 'Existencia y tipos de propiedades se validan en la aplicación.', estado: 'aceptada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-06'}) SET n += {nombre: 'RI-10 \'al menos un responsable\' solo en el servicio', descripcion: 'El índice único parcial cubre \'a lo más uno\'.', estado: 'aceptada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-07'}) SET n += {nombre: 'Ciclos en la jerarquía validados por consulta', descripcion: 'Ninguna restricción del motor impide ciclos; se validan con consulta recursiva y bloqueo dentro de la transacción.', estado: 'parchada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-08'}) SET n += {nombre: 'Escritura sin transacción distribuida en sustituciones', descripcion: 'Neo4j y PostgreSQL se escriben por separado; mitigada con reconciliación.', estado: 'parchada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-09'}) SET n += {nombre: 'Tipo de documento duplicado en MongoDB', descripcion: 'Duplicación controlada: el tipo no cambia después del registro.', estado: 'parchada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-10'}) SET n += {nombre: 'Expediente creado después del documento', descripcion: 'Si MongoDB falla, el documento queda sin expediente; mitigada con outbox destino mongodb.', estado: 'parchada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-11'}) SET n += {nombre: 'referencias_citadas en texto libre', descripcion: 'Duplica información de las relaciones del grafo sin vínculo formal.', estado: 'aceptada'};
MERGE (n:Nodo:`Entregable` {id: 'E-1'}) SET n += {nombre: 'Propuesta de aplicación', descripcion: 'Entregable 1 de la guía.', estado: 'redactado (en revisión)'};
MERGE (n:Nodo:`Entregable` {id: 'E-2'}) SET n += {nombre: 'Modelado de datos', descripcion: 'Entregable 2 de la guía.', estado: 'redactado (en revisión)'};
MERGE (n:Nodo:`Entregable` {id: 'E-3'}) SET n += {nombre: 'Arquitectura y selección tecnológica', descripcion: 'Entregable 3 de la guía.', estado: 'en curso'};
MERGE (n:Nodo:`Entregable` {id: 'E-4'}) SET n += {nombre: 'Implementación de las tres bases', descripcion: 'Entregable 4 de la guía.', estado: 'pendiente'};
MERGE (n:Nodo:`Entregable` {id: 'E-5'}) SET n += {nombre: 'Catálogo de operaciones y consultas', descripcion: 'Entregable 5 de la guía.', estado: 'redactado (en revisión)'};
MERGE (n:Nodo:`Entregable` {id: 'E-6'}) SET n += {nombre: 'Backend y API', descripcion: 'Entregable 6 de la guía.', estado: 'pendiente'};
MERGE (n:Nodo:`Entregable` {id: 'E-7'}) SET n += {nombre: 'Aplicación e integración', descripcion: 'Entregable 7 de la guía.', estado: 'pendiente'};
MERGE (n:Nodo:`Entregable` {id: 'E-8'}) SET n += {nombre: 'Pruebas, documentación y despliegue', descripcion: 'Entregable 8 de la guía.', estado: 'pendiente'};
MERGE (n:Nodo:`Contexto` {id: 'CTX-05'}) SET n += {nombre: 'Entrevista complementaria', descripcion: 'Seis preguntas de seguimiento a la encargada de la Oficialía de Partes. Las referencias como 2c-1 remiten a sus respuestas.'};
MERGE (n:Nodo:`Contexto` {id: 'CTX-06'}) SET n += {nombre: 'Retroalimentación del profesor', descripcion: 'Pidió casos de uso con sus flujos, distinguir qué consulta es de grafo y qué es de documento, y justificar PostgreSQL con volumen y frecuencia.'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-11'}) SET n += {nombre: 'Documentos confidenciales y visibilidad entre áreas', descripcion: 'Personal, quejas y denuncias, jurídicos y algunos de auditoría solo los ven el jefe y quien atiende. De otras áreas basta saber estado y responsable (2c-3).', referencia_entrevista: '2c-3'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-12'}) SET n += {nombre: 'Registro doble por correo y papel', descripcion: 'El escaneado se registra al llegar por correo y el original otra vez en ventanilla; el sello del papel debería ser la fecha oficial. La numeración del emisor suele reiniciar cada año, con excepciones (2c-1).', referencia_entrevista: '2c-1'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-13'}) SET n += {nombre: 'Pendientes heredados y responsabilidad en el tiempo', descripcion: 'Al cambiar el titular, los pendientes se quedan sin dueño; para quejas importa quién era titular cuando se turnó, no quién lo es hoy (2c-2).', referencia_entrevista: '2c-2'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-14'}) SET n += {nombre: 'Asuntos ligados al responder, no al registrar', descripcion: 'Nadie decide formalmente qué documentos forman un asunto; lo hace quien atiende, casi siempre al contestar (2c-4).', referencia_entrevista: '2c-4'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-15'}) SET n += {nombre: 'Devoluciones legítimas frente a rebotes', descripcion: 'Devolución normal: motivo concreto y regresa a quien envió. Rebote: sin motivo, \'no es de nuestra competencia\' sin redirigir o tres o más áreas (2c-5).', referencia_entrevista: '2c-5'};
MERGE (n:Nodo:`Hallazgo` {id: 'H-16'}) SET n += {nombre: 'Citas a documentos no registrados y registros tardíos', descripcion: 'Es común citar oficios de otras instituciones, de administraciones anteriores o mal numerados; al localizarlos se registran tarde con la fecha de hoy (2c-6).', referencia_entrevista: '2c-6'};
MERGE (n:Nodo:`Concepto` {id: 'K-DNR'}) SET n += {nombre: 'Documento no registrado', descripcion: 'Documento citado que no está en el sistema: número y emisor en texto. Solo existe en Neo4j.'};
MERGE (n:Nodo:`Operacion` {id: 'O-08'}) SET n += {nombre: 'Asignar documento a un asunto', descripcion: 'En cualquier momento, no en ventanilla (D-30); un documento puede pertenecer a varios asuntos', seccion: 'Relaciones y asuntos', roles: 'TI, PE', recibe: 'Id del documento e id del asunto', devuelve: 'Pertenencia creada', reglas: 'En cualquier momento, no en ventanilla (D-30); un documento puede pertenecer a varios asuntos', tipo_operacion: 'E', bases: 'NJ', frecuencia: 'Media', nucleo: true};
MERGE (n:Nodo:`Regla` {id: 'RI-06'}) SET n += {nombre: 'Todo documento tiene emisor', descripcion: 'Un área emisora o un actor externo. Redacción reconstruida desde HU-EMI; confirmar contra E-2.', imposicion: 'PostgreSQL'};
MERGE (n:Nodo:`Regla` {id: 'RI-10'}) SET n += {nombre: 'Un solo responsable por grupo de turno', descripcion: '\'A lo más uno\' con índice único parcial sobre id_grupo_turno; \'al menos uno\' en el servicio (DT-06).', imposicion: 'PostgreSQL y backend'};
MERGE (n:Nodo:`Regla` {id: 'RI-14'}) SET n += {nombre: 'Conclusión explícita', descripcion: 'Un documento solo se concluye con forma_conclusion registrada, de las cinco del catálogo D-59. Redacción reconstruida desde HU-D3; confirmar contra E-2.', imposicion: 'PostgreSQL y backend'};
MERGE (n:Nodo:`Decision` {id: 'D-24'}) SET n += {nombre: 'Asunto y referencias con fuente en Neo4j', descripcion: 'Son los únicos datos propios del grafo; justifican el paradigma.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-25'}) SET n += {nombre: 'Protección de los datos propios del grafo', descripcion: 'Unicidad en id, réplica con MERGE que nunca borra Asunto ni referencias, y respaldo con neo4j-admin database dump.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-26'}) SET n += {nombre: 'Tipo inmutable verificado por reconciliación', descripcion: 'El backend nunca actualiza el tipo; una consulta compara el tipo en PostgreSQL y en MongoDB.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-27'}) SET n += {nombre: 'Clave de duplicados con año', descripcion: 'UNIQUE parcial sobre número, emisor (área o actor externo) y año de fecha_documento; así no hace falta interpretar el número y funcionan los oficios sin año o con consecutivo continuado. Sin número o sin fecha_documento se marca posible_duplicado y lo revisa una persona.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-28'}) SET n += {nombre: 'Correo y papel en un solo documento', descripcion: 'canal_inicial, fecha_recepcion_inicial y fecha_recepcion_oficial (sello). El folio se asigna en la primera recepción.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-29'}) SET n += {nombre: 'Visibilidad en tres niveles aplicada en el backend', descripcion: 'Lo suyo completo; de otras áreas estado y responsable; dirección y oficialía todo el recorrido. Confidencial por documento, marcado por oficialía, visible al titular y a quien tiene movimiento. Una función central pasa $areasVisibles a cada consulta.', estado: 'tomada', supuesto: true};
MERGE (n:Nodo:`Decision` {id: 'D-30'}) SET n += {nombre: 'Asignación de asuntos por quien atiende', descripcion: 'Manual, en cualquier momento, con O-08; no se exige en el registro. Un documento puede pertenecer a varios asuntos.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-31'}) SET n += {nombre: 'Titular al turnar en el movimiento', descripcion: 'id_titular_al_turnar se guarda al turnar (nulo si el puesto está vacante); como el movimiento es inmutable, el dato queda fijo.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-32'}) SET n += {nombre: 'Motivos de devolución y regla de rebote', descripcion: 'Catálogo cerrado: falta_informacion, falta_firma, falta_anexo, corregir_dato, no_competencia (área sugerida opcional; sin ella cuenta como rebote). C3 usa la regla de H-15.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-33'}) SET n += {nombre: 'Nodo DocumentoNoRegistrado', descripcion: 'RESPONDE_A, DA_SEGUIMIENTO_A y EN_ALCANCE_A pueden apuntar a un nodo con número y emisor en texto; SUSTITUYE_A no, porque cambia el estado en PostgreSQL. El ligado al documento real, si se registra después, es manual.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-34'}) SET n += {nombre: 'Registro extemporáneo', descripcion: 'El folio sigue el orden y el año de registro; se captura la fecha real de recepción y la marca extemporaneo.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-35'}) SET n += {nombre: 'Justificar PostgreSQL por garantías, no por escala', descripcion: 'Unos 300 documentos por semana en temporada alta es poco volumen; el argumento es la integridad transaccional.', estado: 'tomada'};
MERGE (n:Nodo:`Hueco` {id: 'HU-G3'}) SET n += {nombre: 'Mismo documento por correo y papel', descripcion: 'Un solo documento con dos fechas de recepción.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-G4'}) SET n += {nombre: 'Numeración sin año o consecutivo continuado', descripcion: 'Cubierta al usar el año de fecha_documento; sin número o sin fecha se marca posible_duplicado.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-H4'}) SET n += {nombre: 'Acceso a confidenciales por persona', descripcion: 'Titular del área y personas con movimiento sobre el documento, calculado de los movimientos.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-H5'}) SET n += {nombre: 'Confidencialidad por documento, no por tipo', descripcion: 'Campo confidencial marcado por oficialía al registrar.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-C5'}) SET n += {nombre: 'Registro extemporáneo y orden de folios', descripcion: 'Folio por orden de registro con fecha real de recepción.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-MG1'}) SET n += {nombre: 'Tipo en MongoDB contradictorio', descripcion: 'MongoDB guarda id y tipo; el tipo es inmutable y se reconcilia.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-NJ1'}) SET n += {nombre: 'Asunto y referencias sin respaldo', descripcion: 'Unicidad, réplica que no borra y respaldo periódico.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-PG'}) SET n += {nombre: 'Justificación de PostgreSQL por volumen', descripcion: 'Se justifica por garantías transaccionales, no por escala.', estado: 'resuelto'};
MERGE (n:Nodo:`Hueco` {id: 'HU-VIS'}) SET n += {nombre: 'Reglas de visibilidad sin validar por dirección y Jurídico', descripcion: 'Se toma lo descrito por la entrevistada como supuesto declarado.', estado: 'aceptado'};
MERGE (n:Nodo:`Alcance` {id: 'AL-01'}) SET n += {nombre: 'Fuera de alcance y limitaciones declaradas', descripcion: 'Plazos y días hábiles; historial de titulares, adscripciones y reestructuraciones; sugerencia automática de asuntos; extracción automática de referencias; archivos binarios de anexos; permisos configurables por persona. El sistema refleja registros, no la realidad.'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-12'}) SET n += {nombre: 'Asunto y referencias sin réplica', descripcion: 'Solo viven en Neo4j; mitigada con unicidad, réplica que no borra y respaldo.', estado: 'parchada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-13'}) SET n += {nombre: 'Visibilidad solo en el servicio', descripcion: 'Ningún motor impone la visibilidad; un error en una consulta expone datos.', estado: 'aceptada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-14'}) SET n += {nombre: 'Ligado manual de documentos no registrados', descripcion: 'Si el documento citado se registra después, alguien debe ligarlo a mano.', estado: 'aceptada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-15'}) SET n += {nombre: 'Folios fuera de orden cronológico', descripcion: 'Los registros extemporáneos reciben folio con fecha de registro posterior a la recepción.', estado: 'aceptada'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-16'}) SET n += {nombre: 'Duplicados sin número o sin fecha con revisión manual', descripcion: 'La marca posible_duplicado depende de que alguien la revise.', estado: 'aceptada'};
MERGE (n:Nodo:`Decision` {id: 'D-36'}) SET n += {nombre: 'Aplicación web', descripcion: 'La interfaz es obligatoria (confirmado). Es una aplicación web que consume solo la API y nunca se conecta a las bases (guía, sección 2.4 y entregable 6). La guía acepta web, móvil o escritorio; se elige web.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-37'}) SET n += {nombre: 'Backend en Python con FastAPI', descripcion: 'Routers, servicios y repositorios separados. Se elige porque la guía pide contrato de API documentado y validación de entradas (OpenAPI y Pydantic vienen incluidos), el esquema vive en scripts SQL sin ORM y se tiene experiencia previa con Python. Descartados NestJS y .NET (más código de estructura y un lenguaje nuevo) y Django (su ORM solo cubre una de las tres bases y duplica el DDL).', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-38'}) SET n += {nombre: 'Frontend en React, Vite y TypeScript', descripcion: 'Aplicación de una sola página sin servidor propio, para que la interfaz no pueda conectarse a las bases ni alojar lógica de negocio. Cliente de la API generado desde el OpenAPI de FastAPI; sesión en cookie httpOnly y CORS limitado al origen del frontend. Descartado Next.js: su parte de servidor duplicaría el backend y arriesga el criterio 7 de la guía.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-39'}) SET n += {nombre: 'API REST', descripcion: 'C1 a C5 y las operaciones se exponen como endpoints fijos; no hace falta la consulta flexible de GraphQL.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-40'}) SET n += {nombre: 'Repositorios con drivers oficiales y sin ORM', descripcion: 'psycopg 3 para PostgreSQL, PyMongo con su API asíncrona para MongoDB (Motor está en desuso) y el driver oficial de Neo4j. Un repositorio por base, consultas parametrizadas y credenciales en variables de entorno.', estado: 'tomada'};
MERGE (n:Nodo:`Decision` {id: 'D-41'}) SET n += {nombre: 'Despliegue con docker-compose', descripcion: 'Las tres bases, la API, el proceso del outbox y el frontend compilado como archivos estáticos se levantan con un solo docker-compose; cubre la instalación reproducible del entregable 8.', estado: 'tomada'};
MERGE (n:Nodo:`Hueco` {id: 'HU-OP14'}) SET n += {nombre: 'RF-14 sin operación asignada', descripcion: 'RF-14 queda cubierto por O-20 y O-21.', estado: 'resuelto'};
MERGE (n:Nodo:`DeudaTecnica` {id: 'DT-17'}) SET n += {nombre: 'Autenticación y roles construidos a mano', descripcion: 'FastAPI no trae usuarios ni roles: se implementan con sesiones en PostgreSQL (D-49) y la función central de visibilidad (D-29).', estado: 'aceptada'};
MERGE (n:Nodo:`Rol` {id: 'ROL-OF'}) SET n += {nombre: 'Oficialía de partes', descripcion: 'Registra entradas y salidas, turna, cancela, corrige y resuelve duplicados. Ve el recorrido de todo, sin el contenido de lo confidencial ajeno.', clave: 'OF'};
MERGE (n:Nodo:`Rol` {id: 'ROL-DI'}) SET n += {nombre: 'Dirección', descripcion: 'Turna y consulta el recorrido de todo, sin el contenido de lo confidencial ajeno.', clave: 'DI'};
MERGE (n:Nodo:`Rol` {id: 'ROL-TI'}) SET n += {nombre: 'Titular de área', descripcion: 'Turna de forma directa desde su área, devuelve, returna, atrae y concluye. Ve lo suyo completo.', clave: 'TI'};
MERGE (n:Nodo:`Rol` {id: 'ROL-PE'}) SET n += {nombre: 'Personal del área', descripcion: 'Atiende y concluye solo cuando su área es la responsable; agrega notas y anexos.', clave: 'PE'};
MERGE (n:Nodo:`Rol` {id: 'ROL-AD'}) SET n += {nombre: 'Administrador', descripcion: 'Gestiona áreas, personas, usuarios y roles.', clave: 'AD'};
MERGE (n:Nodo:`Operacion` {id: 'O-19'}) SET n += {nombre: 'Registrar segunda recepción', descripcion: 'Si el segundo canal es papel, su sello fija la fecha oficial; el folio no cambia (D-28); un segundo registro por el mismo canal se rechaza', seccion: 'Recepción, registro y corrección', roles: 'OF', recibe: 'Id del documento, canal, fecha y hora del sello', devuelve: 'Documento con sus dos fechas de recepción', reglas: 'Si el segundo canal es papel, su sello fija la fecha oficial; el folio no cambia (D-28); un segundo registro por el mismo canal se rechaza', tipo_operacion: 'E', bases: 'PG', frecuencia: 'Media', nucleo: false};
