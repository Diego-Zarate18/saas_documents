# Variables de SIGEDOC. Copia este archivo a .env (que no se versiona) y cambia las contraseñas.
# Los valores de aquí son de desarrollo y evidentes a propósito: no son credenciales reales.
# docker-compose y el backend leen el mismo .env.

# PostgreSQL 17. 5433 y no 5432 para no chocar con un PostgreSQL instalado en Windows.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=sigedoc
POSTGRES_USER=sigedoc
POSTGRES_PASSWORD=cambia-esta-clave-postgres

# MongoDB 8.0. La URI no lleva credenciales: usuario y contraseña van aparte.
# 27018 y no 27017 para no chocar con un MongoDB instalado en Windows; MONGO_PORT y MONGO_URI deben coincidir.
MONGO_PORT=27018
MONGO_URI=mongodb://127.0.0.1:27018
MONGO_DB=sigedoc
MONGO_USER=sigedoc
MONGO_PASSWORD=cambia-esta-clave-mongo

# Neo4j 5.26 Community. El usuario es siempre neo4j y la contraseña necesita al menos 8 caracteres.
# NEO4J_BOLT_PORT y el puerto de NEO4J_URI deben coincidir.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia-esta-clave-neo4j
# Memoria de Neo4j (heap y page cache), pequeña para una laptop.
NEO4J_MEMORIA_HEAP=512m
NEO4J_MEMORIA_PAGECACHE=256m

# API e interfaz (servicio web: la aplicación en http://localhost:8080)
API_PORT=8000
WEB_PORT=8080
API_CORS_ORIGEN=http://localhost:5173
SESION_MINUTOS_INACTIVIDAD=30

# Proceso del outbox (T-08)
OUTBOX_INTERVALO_MS=1000
OUTBOX_MAX_INTENTOS=5
