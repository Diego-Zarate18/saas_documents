MERGE (n:Nodo:`Operacion` {id: 'O-23'}) SET n += {nombre: 'Atraer documento', descripcion: 'El área que atrae queda como responsable y el área anterior deja de tenerlo pendiente; requiere visibilidad sobre el documento', seccion: 'Recorrido del documento', roles: 'TI', recibe: 'Id del documento y justificación', devuelve: 'Movimiento de atracción', reglas: 'El área que atrae queda como responsable y el área anterior deja de tenerlo pendiente; requiere visibilidad sobre el documento', tipo_operacion: 'E', bases: 'PG+NJ', frecuencia: 'Baja', nucleo: false};
